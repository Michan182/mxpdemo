{
    "name": "mxpdemo",
    "version": "1.0.0",
    "private": true,
    "description": "E2E-тест формы заявки на демо mxp.net (Playwright + TypeScript)",
    "scripts": {
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:repeat": "playwright test --repeat-each=3 --workers=1",
        "report": "playwright show-report",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "license": "ISC",
    "devDependencies": {
        "@faker-js/faker": "^9.9.0",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.6",
        "dotenv": "^18.0.9",
        "eslint": "^10.14.0",
        "eslint-plugin-playwright": "^2.12.2",
        "mailslurp-client": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    }
}
